# Copy to .env.local (gitignored).
# Clerk publishable key: the same pk_test_ key as apps/web/.env.local.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# API origin, no trailing slash. Local backend works for web and the iOS
# simulator; a phone or the Android emulator needs your Mac's LAN IP, or the
# production API through the site proxy: https://politmus.com (the API
# itself has no public address)
EXPO_PUBLIC_API_URL=http://localhost:8000
